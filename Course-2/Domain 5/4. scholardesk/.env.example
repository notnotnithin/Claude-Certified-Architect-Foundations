# Copy this file to ".env" (exact name, no .example) and paste in your real key.
#
#   Windows cmd:   copy .env.example .env
#
# Get a key from https://console.anthropic.com/  ->  API Keys
# ScholarDesk uses the Claude API in most parts of Domain 5, so you'll need this
# key throughout (except Part 4, which uses Claude Code instead).
#
# Never commit your real .env file - it is already listed in .gitignore.

ANTHROPIC_API_KEY=sk-ant-your-key-here
